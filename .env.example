# ===================================================
# SmartCart Environment Variables Reference
# ===================================================

# Database (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password

# JWT Security
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_length

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Mail Service (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Frontend API Connection
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws-smartcart
